{"ast":null,"code":"/* -------------------------------------------------------------------------- */\n/*                                   Filters                                  */\n/* -------------------------------------------------------------------------- */\n\n/* -------------------------------------------------------------------------- */\n/*                                   Status                                   */\n/* -------------------------------------------------------------------------- */\n\n/* -------------------------------------------------------------------------- */\n/*                                   Columns                                  */\n/* -------------------------------------------------------------------------- */\n\n/* -------------------------------------------------------------------------- */\n/*                               Status Helpers                               */\n/* -------------------------------------------------------------------------- */\n\nexport function deriveStatus(user) {\n  // suspended\n  if (user.is_active === false) {\n    return \"suspended\";\n  }\n\n  // pending\n  if (user.registration_status === \"pending\") {\n    return \"pending\";\n  }\n\n  // dormant (optional logic)\n  if (!user.updated_at) {\n    return \"dormant\";\n  }\n\n  // default\n  return \"active\";\n}","map":{"version":3,"names":["deriveStatus","user","is_active","registration_status","updated_at"],"sources":["/Users/user/weera.admin/src/features/shared/types.ts"],"sourcesContent":["import type { User } from \"@features/users/types\";\n\n/* -------------------------------------------------------------------------- */\n/*                                   Filters                                  */\n/* -------------------------------------------------------------------------- */\n\nexport type UserTypeFilter =\n  | \"all\"\n  | \"clients\"\n  | \"bidders\";\n\nexport type StatusFilter =\n  | \"all\"\n  | \"active\"\n  | \"suspended\"\n  | \"pending\"\n  | \"dormant\";\n\n/* -------------------------------------------------------------------------- */\n/*                                   Status                                   */\n/* -------------------------------------------------------------------------- */\n\nexport type Status =\n  | \"active\"\n  | \"suspended\"\n  | \"pending\"\n  | \"dormant\";\n\n/* -------------------------------------------------------------------------- */\n/*                                   Columns                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface Column {\n  label: string;\n  key: keyof User;\n}\n\n/* -------------------------------------------------------------------------- */\n/*                               Status Helpers                               */\n/* -------------------------------------------------------------------------- */\n\nexport function deriveStatus(user: User): Status {\n  // suspended\n  if (user.is_active === false) {\n    return \"suspended\";\n  }\n\n  // pending\n  if (user.registration_status === \"pending\") {\n    return \"pending\";\n  }\n\n  // dormant (optional logic)\n  if (!user.updated_at) {\n    return \"dormant\";\n  }\n\n  // default\n  return \"active\";\n}"],"mappings":"AAEA;AACA;AACA;;AAcA;AACA;AACA;;AAQA;AACA;AACA;;AAOA;AACA;AACA;;AAEA,OAAO,SAASA,YAAYA,CAACC,IAAU,EAAU;EAC/C;EACA,IAAIA,IAAI,CAACC,SAAS,KAAK,KAAK,EAAE;IAC5B,OAAO,WAAW;EACpB;;EAEA;EACA,IAAID,IAAI,CAACE,mBAAmB,KAAK,SAAS,EAAE;IAC1C,OAAO,SAAS;EAClB;;EAEA;EACA,IAAI,CAACF,IAAI,CAACG,UAAU,EAAE;IACpB,OAAO,SAAS;EAClB;;EAEA;EACA,OAAO,QAAQ;AACjB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}